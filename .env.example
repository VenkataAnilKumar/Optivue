# FinOps Agent — Environment Variables
# Copy to .env and fill in values before running locally.

# AWS
AWS_REGION=us-east-1
CDK_ACCOUNT=
CDK_REGION=us-east-1

# Bedrock
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# Athena / S3
ATHENA_DATABASE=finops_cost_db
ATHENA_WORKGROUP=finops-primary
COST_EXPORT_S3_BUCKET=
ATHENA_RESULTS_S3_BUCKET=

# DynamoDB
DYNAMODB_RECOMMENDATIONS_TABLE=finops-recommendations
DYNAMODB_APPROVALS_TABLE=finops-approvals
DYNAMODB_ACTION_HISTORY_TABLE=finops-action-history
DYNAMODB_KPI_TABLE=finops-kpi-metrics

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_SECRET_NAME=finops/jira-api-token
JIRA_PROJECT_KEY=FINOPS

# Slack / Teams
SLACK_SECRET_NAME=finops/slack-webhook-url

# Application
RECOMMENDATION_CONFIDENCE_THRESHOLD=0.70
DEMO_MODE=false
STEP_FUNCTIONS_ARN=
